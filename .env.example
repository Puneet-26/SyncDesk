# AICTE SIH26264 Configuration Template

# -------------------------------------------------------------
# BACKEND ENVIRONMENT VARIABLES (Set in Render Dashboard)
# -------------------------------------------------------------
PROJECT_NAME="Integrated AICTE Institution Complaint Monitoring and Coordination System"

# Secret key for signing JWT tokens (generate using: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=aicte_sih_super_secret_production_ready_jwt_key_2026

# Database connection:
# - Local Development: sqlite:///./aicte_complaints.db
# - Production Supabase PostgreSQL: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#   (or Session/Transaction Pooler): postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///./aicte_complaints.db

# Auto-seed database on first startup if empty (true/false)
AUTO_SEED=true

# Allowed CORS Origins (comma-separated or JSON list)
# Note: all https://*.vercel.app domains are automatically permitted by regex
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -------------------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (Set in Vercel Dashboard)
# -------------------------------------------------------------
# Public URL of your deployed Render backend
# Example: https://aicte-complaint-backend.onrender.com/api/v1
VITE_API_URL=http://localhost:8000/api/v1
